PAYTM_API_KEY=your_api_key
PAYTM_SECRET_KEY=your_api_secret
PORT=3000
API_PUBLIC_URL=http://localhost:3000
APP_ORIGINS=http://localhost:3001
REDIS_URL=redis://localhost:6379
REDIS_DATABASE=2
PRICE_WS_PATH=/ws/market
UPSTREAM_PRICE_MODE=QUOTE
MAX_PRICE_SUBSCRIPTIONS=100
PRICE_CONTROL_CHANNEL=market:control
PRICE_EVENTS_CHANNEL=market:events:quotes
LATEST_QUOTE_PREFIX=market:quote:latest
CANDLE_PREFIX=market:candles:1m
SUBSCRIPTION_LEASE_PREFIX=market:subscription:leases
SUBSCRIPTION_LEASE_MS=45000
SUBSCRIPTION_HEARTBEAT_MS=15000
SUBSCRIPTION_SWEEP_MS=20000
QUOTE_STALE_MS=15000
CATALOG_FILES=security_master.csv
CATALOG_REFRESH_MINUTES=720
CANDLE_RETENTION_DAYS=14

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mock_trader
DATABASE_POOL_MAX=10

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters

EMAIL_PROVIDER=console
