PAYTM_API_KEY=your_api_key
PAYTM_SECRET_KEY=your_api_secret
PORT=5000
API_PUBLIC_URL=http://localhost:5000
# Comma-separated browser origins (scheme + host + port, no path or wildcard).
# These same origins are used for credentialed CORS, Better Auth, and WebSocket checks.
# A localhost origin also allows 127.0.0.1 and [::1] on the same port.
APP_ORIGINS=http://localhost:3001
REDIS_URL=redis://localhost:6379
REDIS_DATABASE=2
PRICE_WS_PATH=/ws/market
UPSTREAM_PRICE_MODE=QUOTE
MAX_PRICE_SUBSCRIPTIONS=100
PRICE_CONTROL_CHANNEL=market:control
PRICE_EVENTS_CHANNEL=market:events:quotes
LATEST_QUOTE_PREFIX=market:quote:latest
CANDLE_PREFIX=market:candles:1m
SUBSCRIPTION_LEASE_PREFIX=market:subscription:leases
SUBSCRIPTION_LEASE_MS=45000
SUBSCRIPTION_HEARTBEAT_MS=15000
SUBSCRIPTION_SWEEP_MS=20000
QUOTE_STALE_MS=15000
CATALOG_FILES=security_master.csv
CATALOG_REFRESH_MINUTES=720
CANDLE_RETENTION_DAYS=14

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mock_trader
DATABASE_POOL_MAX=10

BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# lax (default) works when the frontend and API share a site, e.g. app.example.com
# and api.example.com, or localhost on two ports. Use none only when they are on
# different sites; that forces Secure cookies.
# AUTH_COOKIE_SAMESITE=lax

EMAIL_PROVIDER=console
# Production email:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Mock Trader <no-reply@example.com>


#GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging: one plain-text line per event on stdout (warnings and errors on stderr).
# LOG_LEVEL is debug | info | warn | error | silent. Health checks, docs and CORS
# preflights are logged at debug. LOG_STACKS=1 adds stack traces (escaped onto the
# same line).
LOG_LEVEL=info
# LOG_STACKS=1
